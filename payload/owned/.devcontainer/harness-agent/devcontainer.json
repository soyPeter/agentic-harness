// Agentic harness: sandbox for unattended runs (harness-owned).
// Open the project in this container ("Dev Containers: Reopen in Container", then pick harness-agent),
// or use the devcontainer CLI, and run: python3 scripts/harness/lib/harness.py run
// Or let run on the host bring it up and run each session in it: HARNESS_SANDBOX_START="on" in backbone/harness.conf.
// In a thin project, run: python3 ~/.agentic-harness/plugins/agentic-harness/plugin/launcher.py run
// (thin-engine.py fetches the release the project pins when the container starts, and Claude Code loads it as the
// plugin; HARNESS_ENGINE_SOURCE on the host names another repository to fetch it from).
// Inside, the agent may skip permission prompts because the container is the boundary:
// outbound network is limited to an allowlist that a second container enforces (docker-compose.yml), there are no
// host credentials, and the workspace is the only folder from the host. The harness hooks still apply to everything
// the agent does, and each judge verdict records this sandbox as evidence (ADR-003).
// Extra hosts for the allowlist: HARNESS_FIREWALL_ALLOW in docker-compose.yml.
// Credentials come from the host environment: CLAUDE_CODE_OAUTH_TOKEN (from `claude setup-token`, uses your
// Claude subscription) or ANTHROPIC_API_KEY (billed per token). The host's keychain login is not visible here.
// Knowledge source (backbone/HOOKS.md): mount the vault read-only in the agent service of docker-compose.yml, point
// the harness at the mount and register the server inside the container, for example:
//   volumes:      - /path/to/vault:/knowledge:ro                   (agent service, docker-compose.yml)
//   environment:  HARNESS_KNOWLEDGE_ROOT: /knowledge               (agent service, docker-compose.yml)
//   "postStartCommand": "... && claude mcp add -s user knowledge -- python3 /knowledge/<server script>"
// and install the server's dependencies in a Dockerfile that builds FROM this one.
{
  "name": "harness-agent",
  "dockerComposeFile": "docker-compose.yml",
  "service": "agent",
  "runServices": ["egress", "agent"],
  "workspaceFolder": "/workspace",
  "remoteUser": "agent",
  "remoteEnv": {
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}",
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "HARNESS_ENGINE_SOURCE": "${localEnv:HARNESS_ENGINE_SOURCE}"
  },
  "postStartCommand": "python3 /usr/local/bin/trust-workspace.py /workspace && python3 /usr/local/bin/thin-engine.py /workspace"
}
