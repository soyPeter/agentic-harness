#!/usr/bin/env python3
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile


# Git sets these for a hook (`git rev-parse --local-env-vars`); left in place, git commands on the engine cache would
# read the calling repository instead, which in a linked worktree is a different one.
GIT_LOCAL_VARS = ("GIT_ALTERNATE_OBJECT_DIRECTORIES", "GIT_CONFIG", "GIT_CONFIG_PARAMETERS", "GIT_CONFIG_COUNT",
                  "GIT_OBJECT_DIRECTORY", "GIT_DIR", "GIT_WORK_TREE", "GIT_IMPLICIT_WORK_TREE", "GIT_GRAFT_FILE",
                  "GIT_INDEX_FILE", "GIT_NO_REPLACE_OBJECTS", "GIT_REPLACE_REF_BASE", "GIT_PREFIX", "GIT_SHALLOW_FILE",
                  "GIT_COMMON_DIR")
cache_env = {key: value for key, value in os.environ.items() if key not in GIT_LOCAL_VARS}
root = Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip())
lock = json.loads((root / "backbone/.harness-lock.json").read_text())
version, commit = lock.get("version", ""), lock.get("commit", "")
if lock.get("mode") != "thin" or not re.fullmatch(r"[0-9A-Za-z][0-9A-Za-z._-]*", version) or not re.fullmatch(
        r"[0-9a-f]{40}", commit):
    sys.exit("harness: invalid thin-mode pin")
cache = Path(os.environ.get("HARNESS_ENGINES") or Path.home() / ".agentic-harness/engines") / version
source = os.environ.get("HARNESS_ENGINE_SOURCE") or "https://github.com/soyPeter/agentic-harness.git"
if not cache.is_dir():
    cache.parent.mkdir(parents=True, exist_ok=True)
    temporary = Path(tempfile.mkdtemp(prefix=".fetch-", dir=cache.parent))
    try:
        subprocess.run(["git", "clone", "--quiet", "--depth", "1", "--branch", "v" + version, source,
                        str(temporary / "engine")], check=True, timeout=60, env=cache_env)
        try:
            (temporary / "engine").rename(cache)
        except OSError:
            if not cache.is_dir():
                raise
    finally:
        shutil.rmtree(temporary, ignore_errors=True)
head = subprocess.check_output(["git", "-C", str(cache), "rev-parse", "HEAD"], text=True, env=cache_env).strip()
script = cache / "payload/owned/scripts/harness/lib/harness.py"
if head != commit or not script.is_file():
    sys.exit("harness: cached engine does not match the project pin")
if subprocess.run(["git", "-C", str(cache), "status", "--porcelain", "--untracked-files=all"], capture_output=True,
                  text=True, check=True, env=cache_env).stdout.strip():
    sys.exit("harness: the cached engine %s has local changes, so it is not the pinned release; delete it to fetch "
             "it again" % cache)
os.environ["HARNESS_ROOT"] = str(root)
os.execv(sys.executable, [sys.executable, "-I", str(script), "git", "pre-commit"])
